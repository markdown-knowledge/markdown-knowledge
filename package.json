{
  "name": "markdown-knowledge",
  "private": true,
  "version": "0.1.1",
  "description": "Markdown Knowledge (.mdk) – a single-file container of Markdown documents with built-in SQLite full-text search for AI.",
  "keywords": [
    "markdown",
    "knowledge-base",
    "mdk",
    "mdkn",
    "sqlite",
    "full-text-search",
    "fts",
    "bm25",
    "ai",
    "llm",
    "rag",
    "retrieval",
    "context",
    "cli",
    "vscode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/markdown-knowledge/markdown-knowledge"
  },
  "workspaces": [
    "packages/mdkn",
    "packages/vscode-extension"
  ],
  "scripts": {
    "build": "npm run build -w markdown-knowledge && npm run build -w mdk-vscode",
    "test": "npm run test -w markdown-knowledge",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
